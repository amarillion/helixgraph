{
	"compilerOptions": {
		"target": "ES6",
		"module": "node16",
		"lib": ["ES2018", "DOM"],
		"outDir": "./lib",
		"rootDir": "./src",
		"declaration": true,
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"noImplicitAny": true,
		"skipLibCheck": true
	},
	"include": ["./src"],
	"exclude": ["**/*.spec.ts"]
}